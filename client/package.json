{
  "name": "peak-abu",
  "version": "0.1.0",
  "description": "Multi-POV synchronized gameplay highlights",
  "author": "nemeancreates",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "keywords": [],
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "app.peakabu.recorder",
    "productName": "Peak-Abu",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "43.0.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "form-data": "4.0.6",
    "ntp-time": "2.1.1",
    "socket.io-client": "4.8.3"
  }
}