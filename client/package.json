{
  "name": "peak-abu",
  "version": "0.1.99",
  "description": "Multi-POV synchronized gameplay highlights",
  "author": "nemeancreates",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:store": "electron-builder --win appx"
  },
  "keywords": [],
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "app.peakabu.recorder",
    "productName": "Peak-Abu",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "assets/**/*",
      "!ffmpeg/**",
      "!old_main.js",
      "!index-backup.html",
      "!_block0.js"
    ],
    "extraResources": [
      {
        "from": "ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      }
    ],
    "protocols": [
      {
        "name": "Peak-Abu Session",
        "schemes": [
          "peakabu"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "peak-abu-setup-${version}.exe"
    },
    "appx": {
      "identityName": "51439PeakabuLLC.Peakabu",
      "publisher": "CN=98E8B871-881C-4FF5-A125-AD9F14D7A586",
      "publisherDisplayName": "PeakabuLLC",
      "displayName": "Peakabu",
      "applicationId": "PeakAbu",
      "backgroundColor": "#175234",
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0",
      "languages": [
        "en-US"
      ],
      "capabilities": [
        "internetClient",
        "microphone"
      ],
      "artifactName": "peak-abu-${version}.appx"
    }
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "@sentry/electron": "^8.3.0",
    "form-data": "4.0.6",
    "ntp-time": "2.1.1",
    "socket.io-client": "4.8.4"
  }
}
